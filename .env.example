# 复制为 .env 后填入真实值：cp .env.example .env
# ============================================================
#  corp CI/CD 平台 —— 凭据模板（把 <REPLACE_ME> 换成真实值后另存为 .env）
#  用法：bash 里 `set -a; source .env; set +a`；PowerShell 里见 scripts/README.md
#  上传 GitHub 前务必确认：git check-ignore -v .env
# ============================================================

# ---------- 服务器 ----------
SSH_HOST=<REPLACE_ME>
SSH_USER=<REPLACE_ME>
SSH_ROOT_PASS=<REPLACE_ME>

# ---------- GitLab ----------
GITLAB_ROOT_USER=<REPLACE_ME>
GITLAB_ROOT_PASS=<REPLACE_ME>
GITLAB_PAT=<REPLACE_ME>

# ---------- ArgoCD ----------
ARGOCD_ADMIN_USER=<REPLACE_ME>
ARGOCD_ADMIN_PASS=<REPLACE_ME>

# ---------- Harbor ----------
HARBOR_ADMIN_USER=<REPLACE_ME>
HARBOR_ADMIN_PASS=<REPLACE_ME>
HARBOR_ROBOT_CI_USER=<REPLACE_ME>
HARBOR_ROBOT_CI_SECRET=<REPLACE_ME>
HARBOR_ROBOT_JENKINS_USER=<REPLACE_ME>
HARBOR_ROBOT_JENKINS_SECRET=<REPLACE_ME>
HARBOR_ROBOT_LIB_USER=<REPLACE_ME>
HARBOR_ROBOT_LIB_SECRET=<REPLACE_ME>

# ---------- Keycloak ----------
KEYCLOAK_ADMIN_USER=<REPLACE_ME>
KEYCLOAK_ADMIN_PASS=<REPLACE_ME>

# ---------- SonarQube ----------
SONAR_ADMIN_USER=<REPLACE_ME>
SONAR_ADMIN_PASS=<REPLACE_ME>
SONAR_CI_TOKEN=<REPLACE_ME>

# ---------- Artifactory ----------
ARTIFACTORY_ADMIN_USER=<REPLACE_ME>
ARTIFACTORY_ADMIN_PASS=<REPLACE_ME>

# ---------- Jenkins ----------
JENKINS_BREAKGLASS_USER=<REPLACE_ME>
JENKINS_BREAKGLASS_PASS=<REPLACE_ME>

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=<REPLACE_ME>
GRAFANA_ADMIN_PASS=<REPLACE_ME>

# ---------- OpenLDAP ----------
LDAP_ADMIN_DN=<REPLACE_ME>
LDAP_ADMIN_PASS=<REPLACE_ME>
LDAP_USER_INIT_PASS=<REPLACE_ME>

# ---------- 网关 Basic Auth（Prometheus / Alertmanager 控制台） ----------
GATEWAY_BASIC_USER=<REPLACE_ME>
GATEWAY_BASIC_PASS=<REPLACE_ME>

# ---------- Keycloak OIDC client secrets ----------
GITLAB_OIDC_SECRET=<REPLACE_ME>
JENKINS_OIDC_SECRET=<REPLACE_ME>
HARBOR_OIDC_SECRET=<REPLACE_ME>
ARGOCD_DEX_OIDC_SECRET=<REPLACE_ME>
SONAR_OIDC_SECRET=<REPLACE_ME>
ARTIFACTORY_OIDC_SECRET=<REPLACE_ME>
CLI_TEST_OIDC_SECRET=<REPLACE_ME>

# ---------- 钉钉告警机器人（加签模式） ----------
DINGTALK_WEBHOOK_URL=<REPLACE_ME>
DINGTALK_SECRET=<REPLACE_ME>
# ---------- 别名（与 CI/Jenkins 变量名对齐） ----------
PAT=<REPLACE_ME>
SONAR_TOKEN=<REPLACE_ME>
HARBOR_CI_PASS=<REPLACE_ME>
HARBOR_LIB_PASS=<REPLACE_ME>
ARTIFACTORY_USER=<REPLACE_ME>
ARTIFACTORY_PASS=<REPLACE_ME>
BREAKGLASS_PASS=<REPLACE_ME>
LDAP_MANAGER_PASSWORD=<REPLACE_ME>
OIDC_CLIENT_SECRET=<REPLACE_ME>
ARTI_USER=<REPLACE_ME>
ARTI_PASS=<REPLACE_ME>
# ---------- 组件内嵌数据库口令 ----------
KEYCLOAK_DB_PASS=<REPLACE_ME>
SONAR_DB_PASS=<REPLACE_ME>
ARTIFACTORY_DB_PASS=<REPLACE_ME>
# LDAP 初始口令的 URL 编码形式
LDAP_USER_INIT_PASS_URLENC=<REPLACE_ME>
# Alertmanager 邮件通道（当前未启用）
SMTP_AUTH_PASSWORD=
